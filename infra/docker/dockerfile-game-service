# --- Build stage ---
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Cache dependency downloads
COPY backend/game-service/go.mod backend/game-service/go.sum ./
RUN go mod download

# Copy source and build
COPY backend/game-service/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o /game-service ./cmd/server/

# --- Runtime stage ---
FROM alpine:3.21

RUN apk --no-cache add ca-certificates

COPY --from=builder /game-service /game-service

EXPOSE 8001

CMD ["/game-service"]
