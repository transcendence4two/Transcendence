################################################################################
# Stage 1 — builder
################################################################################
FROM redhat/ubi9-minimal:latest AS builder

RUN microdnf install -y tar gzip && microdnf clean all

WORKDIR /tmp

RUN arch="$(rpm --query --queryformat='%{ARCH}' rpm)" && \
    curl -fL -o kibana.tar.gz \
      https://artifacts.elastic.co/downloads/kibana/kibana-9.2.5-linux-${arch}.tar.gz && \
    mkdir -p /usr/share/kibana && \
    tar -xzf kibana.tar.gz --strip-components=1 -C /usr/share/kibana

RUN arch="$(rpm --query --queryformat='%{ARCH}' rpm)" && \
    case "$arch" in \
      x86_64) TINI=tini-amd64 ;; \
      aarch64) TINI=tini-arm64 ;; \
      *) echo "Unsupported arch"; exit 1 ;; \
    esac && \
    curl -fL -o /bin/tini \
      https://github.com/krallin/tini/releases/download/v0.19.0/${TINI} && \
    chmod +x /bin/tini

################################################################################
# Stage 2 — runtime
################################################################################
FROM redhat/ubi9-minimal:latest

RUN microdnf install -y \
      shadow-utils \
      nss \
      findutils \
    && microdnf clean all

WORKDIR /usr/share/kibana

COPY --from=builder --chown=1000:0 /usr/share/kibana /usr/share/kibana
COPY --from=builder /bin/tini /bin/tini

COPY --chown=1000:0 infra/kibana/config/kibana.yml config/kibana.yml

RUN mkdir -p /usr/share/kibana/data && \
    chown -R 1000:0 /usr/share/kibana && \
    chmod -R g=u /usr/share/kibana && \
    chmod g+ws /usr/share/kibana

RUN groupadd -g 1000 kibana && \
    useradd -u 1000 -g 1000 -G 0 \
      --home-dir /usr/share/kibana \
      --no-create-home kibana

ENV ELASTIC_CONTAINER=true
ENV PATH=/usr/share/kibana/bin:$PATH

EXPOSE 5601

ENTRYPOINT ["/bin/tini", "--"]
CMD ["bin/kibana"]

USER 1000