FROM ghcr.io/astral-sh/uv:python3.13-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/tournament-service/pyproject.toml /tmp/pyproject.toml
RUN dependencies="$(python -c "import tomllib; pyproject_file=open('/tmp/pyproject.toml','rb'); print(' '.join(tomllib.load(pyproject_file)['project']['dependencies']))")" \
    && uv pip install --system --no-cache-dir ${dependencies}

COPY backend/tournament-service/src /app/src
COPY backend/tournament-service/main.py /app/main.py

ENV PYTHONPATH=/app
EXPOSE 8002

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
